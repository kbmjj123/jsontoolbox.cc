{
  "name": "@jsontoolbox/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "compile": "vue-tsc --noEmit -p tsconfig.json",
    "postinstall": "wxt prepare",
    "precompile": "pnpm --filter @kbmjj123/json-editor build",
    "predev": "pnpm --filter @kbmjj123/json-editor build",
    "prebuild": "pnpm --filter @kbmjj123/json-editor build",
    "prezip": "pnpm --filter @kbmjj123/json-editor build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@kbmjj123/json-editor": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.18",
    "vue-i18n": "^11.0.0"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.3.4",
    "vue-tsc": "^2.2.0",
    "wxt": "^0.21.5"
  }
}
